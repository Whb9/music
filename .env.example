# =============================================================================
# hbwlxy-music 环境变量
# =============================================================================
# 本地开发：复制此文件为 .env.local 并修改
# 生产环境：在 EdgeOne Pages 控制台设置（项目 -> 设置 -> 环境变量）
# =============================================================================

# ---- 必需 ----

# 后台管理面板登录密码（请务必修改默认值！）
ADMIN_PASSWORD=hbwlxy123

# Session 签名密钥，建议用随机字符串（请务必修改默认值！）
SESSION_SECRET=hbwlxy_music_dance_2024_secret_key

# ---- 可选：构建时变量 ----

# 部署后的公开 URL（用于 SSR 时 API 调用）
# 留空则自动从请求 Host 头中检测
# SITE_URL=https://hbwlxy-music.com

# ---- 可选：COS 文件上传 ----
# 仅在上传文件功能需要时配置

# 腾讯云 API SecretId（需 COS 写入权限）
# COS_SECRET_ID=your_cos_secret_id

# 腾讯云 API SecretKey
# COS_SECRET_KEY=your_cos_secret_key

# COS 存储桶名称
# COS_BUCKET=your-bucket-name

# COS 地域，默认为 ap-guangzhou
# COS_REGION=ap-guangzhou
